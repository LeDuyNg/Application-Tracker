# Local development only. Copy to `.env` and fill in — `.env` is gitignored.
#
#   cp .env.example .env
#   npm run dev
#
# Claude Desktop does NOT read this file. For real use the same two values go in the `env`
# block of claude_desktop_config.json — see README.md.

# The deployed API. https is required (localhost is the only exception, for testing against
# a backend running on this machine).
API_BASE_URL=https://app4jobtrack.me

# Must be the exact value of APP_MCP_TOKEN in /etc/jobtracker/jobtracker.env on the VPS.
# Read it back with:  sudo grep APP_MCP_TOKEN /etc/jobtracker/jobtracker.env
API_TOKEN=

# Optional. IANA timezone used to display interview times. Defaults to this machine's own
# timezone, which is normally what you want. Set it to pin display to the backend's
# app.timezone regardless of where the laptop is.
#APP_TIMEZONE=America/New_York
