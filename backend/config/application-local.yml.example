# Local secrets — COPY THIS FILE to `application-local.yml` in this same directory.
#
#     cp backend/config/application-local.yml.example backend/config/application-local.yml
#
# Why here and not in src/main/resources/application-local.yml: Spring Boot loads `./config/`
# (relative to the working directory, which is `backend/` for both the IntelliJ run config
# and `./mvnw spring-boot:run`) at HIGHER precedence than the classpath. So this file
# overrides the committed one property by property, and the committed one stays free of
# secrets and readable as documentation.
#
# `backend/config/application-local.yml` is gitignored. This `.example` file is not — it is
# the template, and it must never hold a real value.
#
# Nothing here is needed to run the tests: `./mvnw verify` uses Testcontainers and never
# reads this file.
#
# NOTE THE SHAPE: there is exactly ONE top-level `spring:` key, and everything under Spring
# hangs off it. YAML rejects a document with the same top-level key twice — the failure is
# "expected '<document start>', but found '<block mapping start>'" at config-load time,
# before the app starts, and it names the *second* occurrence rather than the duplication.
# So when you uncomment the MongoDB block below, leave it nested where it is.

spring:

  # --- MongoDB --------------------------------------------------------------
  # Local dev normally uses the Docker container, which the committed
  # application-local.yml already points at. Uncomment below only for the one-off Atlas
  # check PLAN.md Phase 1 asks for, then comment it out again.
  #
  # To enable: delete ONLY the `#` on the two lines below. The indentation after it is
  # already correct. (Deleting `# ` — hash *and* space — shifts everything left by one and
  # produces "expected '<document start>', but found '<block mapping start>'", which points
  # at a later line and reads like a duplicate-key problem. It is not.)
  #
  # THE DATABASE NAME IS NOT OPTIONAL. Atlas's "Connect" dialog gives you a string ending
  # in `/?retryWrites=...` with nothing between the slash and the question mark. Paste that
  # as-is and the app dies at startup with "Database name must not be empty". Put
  # `jobtracker` in that gap, exactly as shown here.
  #
  #mongodb:
  #  uri: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/jobtracker?retryWrites=true&w=majority

  # --- Google OAuth (needed from Phase 2) -----------------------------------
  # Google Cloud Console → APIs & Services → Credentials → your Web application client.
  # The redirect URI lives in the committed application-local.yml and points at :5173, the
  # Vite dev server — not :8080. See PLAN.md Phase 3's gotcha about this.
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: PASTE_GOOGLE_CLIENT_ID_HERE
            client-secret: PASTE_GOOGLE_CLIENT_SECRET_HERE

app:
  # The single Google account allowed to log in. Comma-separated, but keep it to one.
  allowed-emails: you@example.com

  # Shared with the MCP server, which sends it as `Authorization: Bearer <token>`.
  #
  #     openssl rand -hex 32
  #
  # Hex rather than base64 on purpose. The same value is later pasted into
  # /etc/jobtracker/jobtracker.env as APP_MCP_TOKEN=... , and base64's `+ / =` are
  # characters that YAML, systemd's EnvironmentFile parser and shell quoting each treat
  # specially in their own way. 32 bytes of hex is 256 bits of entropy with no character
  # that anything downstream can misread.
  mcp-token: PASTE_A_LONG_RANDOM_STRING_HERE

# --- Datadog ----------------------------------------------------------------
# Deliberately absent. The Micrometer registry is `enabled: false` outside the prod profile
# (see application.yml), so a key here would do nothing. In Phase 5 the local Datadog *Agent*
# takes DD_API_KEY through its own config, not through the app.
