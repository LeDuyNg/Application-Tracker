<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>dev.duynguyen</groupId>
    <artifactId>jobtracker</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>jobtracker</name>
    <description>Job application tracker API — companies, applications, and interview stages</description>

    <properties>
        <java.version>25</java.version>
        <springdoc.version>3.1.0</springdoc.version>
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              The Boot parent does not manage Testcontainers module versions, so the BOM
              pins them all from one place. Without this, every org.testcontainers
              dependency below needs its own <version>.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web + JSON. Spring Boot 4 uses Jackson 3 (tools.jackson.*), not com.fasterxml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Repositories + MongoTemplate for the stats aggregations (SCHEMA.md §10). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation on request DTOs (SCHEMA.md §8.1). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- /actuator/health for the deploy smoke check; exposure is limited in application.yml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Swagger UI. 3.x is the line that supports Boot 4 / Spring Framework 7; 2.x does not. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Pushes custom metrics straight to the Datadog API. Configured in Phase 5. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-datadog</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Google OAuth2 login for the browser. Pulls spring-boot-starter-security
          transitively, which is what activates the filter chains in config/SecurityConfig.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          @WithMockUser and the csrf() request post-processor. Split out per technology on
          Boot 4 exactly like spring-boot-starter-webmvc-test below — spring-boot-starter-test
          does not carry it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          MockMvc. In Boot 4 this is NOT part of spring-boot-starter-test any more: the web
          test slices were split into per-technology modules, and @AutoConfigureMockMvc moved
          from org.springframework.boot.test.autoconfigure.web.servlet to
          org.springframework.boot.webmvc.test.autoconfigure. Without this dependency the
          annotation simply does not resolve, and every Boot 3 answer online tells you to use
          the starter you already have.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Testcontainers: real MongoDB for *IT tests, wired via @ServiceConnection.
          Note the artifact names: Testcontainers 2.x renamed the modules from
          `junit-jupiter` / `mongodb` to `testcontainers-junit-jupiter` /
          `testcontainers-mongodb`. Snippets you find online mostly still use the 1.x
          names and will fail to resolve.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Test split (CLAUDE.md §11):
                *Test / *Tests -> Surefire, runs on `mvn test`.   Fast, mocked, no Docker.
                *IT            -> Failsafe, runs on `mvn verify`. Testcontainers, needs Docker.
              Failsafe's `verify` goal is what makes a failed IT fail the build.
            -->
            <!--
              Pin the test order. Maven's default runOrder is `filesystem`, which enumerates
              differently on macOS and on a Linux CI runner — so the two disagree about which
              test class runs first, and any test sensitive to shared-context state passes on
              one and fails on the other with no code difference. That cost a CI-only failure
              once (CsrfCookieIT's javadoc has the story). Alphabetical is arbitrary but the
              same everywhere, which is the whole point.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <runOrder>alphabetical</runOrder>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <runOrder>alphabetical</runOrder>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
