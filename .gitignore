# ---- OS ----
.DS_Store

# ---- IntelliJ ----
# Leading **/ so this matches .idea at any depth, not just the repo root — IntelliJ
# creates one wherever a project is opened (e.g. backend/.idea if you open backend/).
# Run configurations are shared deliberately (PLAN.md Phase 0); everything else is local.
**/.idea/*
!**/.idea/runConfigurations/
*.iml
*.iws
*.ipr

# ---- Java / Maven ----
target/
!.mvn/wrapper/maven-wrapper.jar

# ---- Node (frontend, mcp-server) ----
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
# `tsc -b` incremental state. Lands next to tsconfig.json, not in outDir, so `dist/` above
# does not cover it.
*.tsbuildinfo

# ---- Logs ----
*.log

# ---- Editors (other than IntelliJ, above) ----
.vscode/

# ---- Secrets ----
# Prod config lives in /etc/jobtracker/jobtracker.env on the VPS; nothing secret is
# committed. application-local.yml reads from env vars, so it is safe to commit as-is —
# if you ever paste a real Atlas URI or client secret into it while debugging, move the
# value to an env var rather than committing it.
#
# Any .env: `.env` alone would miss jobtracker.env / prod.env / mcp-server/.env.
*.env
.env
.env.*
!.env.example
!*.env.example

# Local secrets for the backend. Spring Boot loads ./config/ (relative to the working
# directory, i.e. backend/) at HIGHER precedence than src/main/resources, so
# backend/config/application-local.yml overrides the committed application-local.yml
# property by property. That is where a real Atlas URI, Google client secret or MCP token
# goes on this machine. Verified: a server.port set there wins over the committed file.
#
# NOTE: do NOT put secrets in the IntelliJ run configuration's "Environment variables" box.
# .idea/runConfigurations/ is committed on purpose (see the IntelliJ section above), so
# anything typed there is tracked by git.
backend/config/*
!backend/config/*.example

# IntelliJ HTTP Client. The private env file is where the Phase 2 bearer token will live.
# The *.env rules above do NOT match it — the filename ends in .json.
http-client.private.env.json

# Key material. The Phase 4 CI deploy key and any TLS/keystore file must never land here.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
*.ppk

# Database dumps — the Phase 4 mongodump archives contain recruiter names, emails and
# phone numbers plus your own comp expectations. Never commit one.
dump/
*.archive
*.archive.gz
